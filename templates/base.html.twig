<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    {% block head %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{ title|default(webinfo.websitename)|default("Website") }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://kit.fontawesome.com/8310320da1.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/style.css">
    {% endblock %}
</head>
<body class="d-flex flex-column h-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
        <div class="container">
        
            <a href="." class="navbar-brand">{{ webinfo.websitename }}</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-1">
                    <li class="nav-item"><a class="nav-link" href="/">Domů</a></li>                   

                    <li>
                        <form action="/" method="get" class="d-flex flex-row gap-1">
                            <input type="search" name="search" id="search" placeholder="Hledat přispěvek..." class="form-control" value="{{ lastsearch }}">
                            <button type="submit" class="btn btn-success"><i class="fa-solid fa-magnifying-glass"></i></button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
        
    </nav>

    <div class="top-50 sidenav_content">
    {% block base_content %}{% endblock %}
    </div>

    <footer class="mt-auto py-4 bg-dark">
        <div class="container text-white">
            <div class="row row-cols-lg-3">
                <div>
                    <div class="h1">{{ webinfo.websitename }}</div>
                </div>
                <div>
                    {% if webinfo.contacts %}
                        <ul class="list-unstyled flex-row">
                            {% for contact in webinfo.contacts %}
                                {% if contact.info %}<span class='text-white-50'>{{ contact.name }}:</span>
                                <div class='ps-2'>{{ contact.info }}</div>{% endif %}
                            {% endfor %}
                        </ul>
                    {% endif %}                    
                    
                </div>
                <div>
                    {% if webinfo.socials %}
                        <ul class="list-unstyled flex-row">
                            {% for social in webinfo.socials %}
                                {% if social.info %}<li><a href="{{ social.info }}" class="text-white">{{ social.name }}</a></li>{% endif %}
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>